---
const currentYear = new Date().getFullYear();
---

<footer class="bg-stone-900 text-stone-300 mt-20 border-t border-stone-800">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 lg:gap-12">
      <!-- Col 1: Brand -->
      <div class="md:col-span-2 space-y-4">
        <div class="flex items-center gap-2">
          <span class="text-3xl">🍞🍵</span>
          <span class="font-serif text-2xl font-bold tracking-tight text-amber-100">
            Tea & Toast
          </span>
        </div>
        <p class="text-sm text-stone-400 max-w-md leading-relaxed">
          Your cozy digital kitchen for golden artisanal toasts, whipped spreads, comforting bakes, and the mindful art of tea brewing. Elevating morning rituals and afternoon pauses.
        </p>
        <div class="flex items-center space-x-4 pt-2">
          <a
            href="https://www.instagram.com/teaandtoastblog/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-stone-400 hover:text-amber-300 transition flex items-center gap-1.5 text-xs font-medium"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
            @teaandtoastblog
          </a>
        </div>
      </div>

      <!-- Col 2: Navigation -->
      <div class="space-y-3">
        <h4 class="text-xs uppercase tracking-widest font-semibold text-amber-200">Explore</h4>
        <ul class="space-y-2 text-sm text-stone-400">
          <li><a href="/recipes" class="hover:text-amber-300 transition">All Recipes</a></li>
          <li><a href="/recipes?category=Toasts+%26+Spreads" class="hover:text-amber-300 transition">Toasts & Spreads</a></li>
          <li><a href="/recipes?category=Teas+%26+Sips" class="hover:text-amber-300 transition">Teas & Sips</a></li>
          <li><a href="/#tea-toast-pairing" class="hover:text-amber-300 transition">Pairing Assistant</a></li>
          <li><a href="/links" class="hover:text-amber-300 transition">Instagram Bio Links</a></li>
        </ul>
      </div>

      <!-- Col 3: Legal & Trust (Essential for AdSense) -->
      <div class="space-y-3">
        <h4 class="text-xs uppercase tracking-widest font-semibold text-amber-200">Trust & Legal</h4>
        <ul class="space-y-2 text-sm text-stone-400">
          <li><a href="/about" class="hover:text-amber-300 transition">About the Founder</a></li>
          <li><a href="/contact" class="hover:text-amber-300 transition">Contact Us</a></li>
          <li><a href="/privacy-policy" class="hover:text-amber-300 transition">Privacy Policy</a></li>
          <li><a href="/terms" class="hover:text-amber-300 transition">Terms of Service</a></li>
          <li><a href="/disclaimer" class="hover:text-amber-300 transition">Recipe & Nutrition Disclaimer</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-stone-800 mt-12 pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-stone-500 gap-4">
      <p>© {currentYear} Tea & Toast. All rights reserved.</p>
      <p>Crafted with warm tea and golden crisp toast.</p>
    </div>
  </div>
</footer>
