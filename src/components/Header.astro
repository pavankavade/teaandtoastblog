---
const currentPath = Astro.url.pathname;

const recipeCategories = [
  { name: 'All Recipes', href: '/recipes', icon: '✨' },
  { name: 'Toasts & Spreads', href: '/recipes?category=Toasts+%26+Spreads', icon: '🍞' },
  { name: 'Teas & Sips', href: '/recipes?category=Teas+%26+Sips', icon: '🍵' },
  { name: 'Brunch & Bakes', href: '/recipes?category=Brunch+%26+Bakes', icon: '🥐' },
  { name: 'Quick Bites', href: '/recipes?category=Quick+Bites', icon: '⚡' },
];

function isPathActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  if (href.startsWith('/#')) return false;
  const basePath = href.split('?')[0];
  return currentPath === basePath || (basePath !== '/' && currentPath.startsWith(basePath));
}

const isRecipesActive = currentPath.startsWith('/recipes');
---

<header class="sticky top-0 z-50 bg-[#FAF8F5]/98 backdrop-blur-md border-b border-stone-200/80 transition-all duration-200 shadow-sm">
  <!-- Top Announcement Bar -->
  <div id="top-announcement-bar" class="bg-amber-950 text-amber-100 text-xs py-2 px-4 transition-all duration-300">
    <div class="max-w-6xl mx-auto flex items-center justify-between">
      <div class="w-6 hidden sm:block"></div>
      <div class="flex-1 text-center font-medium tracking-wide flex items-center justify-center gap-2 whitespace-nowrap overflow-hidden text-ellipsis">
        <span class="inline-block animate-pulse">✨</span>
        <span class="truncate">Cozy breakfast toasts, comforting bakes & mindful tea pairings • Follow us</span>
        <a
          href="https://www.instagram.com/teaandtoastblog/"
          target="_blank"
          rel="noopener noreferrer"
          class="underline font-bold text-amber-200 hover:text-white inline-flex items-center gap-0.5 transition shrink-0"
        >
          @teaandtoastblog
          <svg class="w-3 h-3 ml-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
      <button
        id="dismiss-bar-btn"
        type="button"
        aria-label="Dismiss banner"
        class="text-amber-300/80 hover:text-white p-1 rounded transition text-xs shrink-0"
      >
        ✕
      </button>
    </div>
  </div>

  <!-- Main Navbar -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20 gap-4">
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 group focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-800 rounded-xl py-1 shrink-0">
        <div class="w-11 h-11 rounded-2xl bg-gradient-to-br from-amber-100 to-orange-100 border border-amber-200/80 flex items-center justify-center text-2xl shadow-inner group-hover:scale-105 transition-transform duration-200 shrink-0">
          🍞
        </div>
        <div class="flex flex-col">
          <span class="font-serif text-2xl sm:text-3xl font-bold tracking-tight text-stone-900 group-hover:text-amber-900 transition-colors whitespace-nowrap">
            Tea & Toast
          </span>
          <span class="text-[10px] uppercase tracking-widest font-bold text-amber-800/80 -mt-1 hidden sm:block whitespace-nowrap">
            Artisanal Breads & Teatime Rituals
          </span>
        </div>
      </a>

      <!-- Desktop Nav Links (Single row, never wrapping) -->
      <nav class="hidden md:flex items-center space-x-1 lg:space-x-2" aria-label="Main Navigation">
        <!-- Home Link -->
        <a
          href="/"
          class={`px-3.5 py-2 rounded-full text-sm font-medium transition duration-150 whitespace-nowrap ${
            isPathActive('/')
              ? 'bg-amber-900 text-amber-50 shadow-sm font-semibold'
              : 'text-stone-700 hover:text-stone-900 hover:bg-stone-100/90'
          }`}
        >
          Home
        </a>

        <!-- Recipes Dropdown -->
        <div class="relative group">
          <a
            href="/recipes"
            class={`inline-flex items-center gap-1.5 px-3.5 py-2 rounded-full text-sm font-medium transition duration-150 whitespace-nowrap ${
              isRecipesActive
                ? 'bg-amber-900 text-amber-50 shadow-sm font-semibold'
                : 'text-stone-700 hover:text-stone-900 hover:bg-stone-100/90'
            }`}
          >
            <span>Recipes</span>
            <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </a>

          <!-- Dropdown Flyout -->
          <div class="absolute top-full left-0 pt-2 w-56 hidden group-hover:block transition-all duration-200 z-50">
            <div class="bg-white rounded-2xl border border-stone-200/90 shadow-xl p-2 space-y-1 backdrop-blur-lg">
              {recipeCategories.map((cat) => (
                <a
                  href={cat.href}
                  class="flex items-center gap-2 px-3 py-2 rounded-xl text-xs font-semibold text-stone-700 hover:text-amber-950 hover:bg-amber-50/80 transition whitespace-nowrap"
                >
                  <span class="text-base">{cat.icon}</span>
                  <span>{cat.name}</span>
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- Pairing Tool Link -->
        <a
          href="/#tea-toast-pairing"
          class="px-3.5 py-2 rounded-full text-sm font-medium text-stone-700 hover:text-stone-900 hover:bg-stone-100/90 transition duration-150 whitespace-nowrap"
        >
          Pairing Tool
        </a>

        <!-- About Link -->
        <a
          href="/about"
          class={`px-3.5 py-2 rounded-full text-sm font-medium transition duration-150 whitespace-nowrap ${
            isPathActive('/about')
              ? 'bg-amber-900 text-amber-50 shadow-sm font-semibold'
              : 'text-stone-700 hover:text-stone-900 hover:bg-stone-100/90'
          }`}
        >
          About
        </a>
      </nav>

      <!-- Right Action Group -->
      <div class="flex items-center space-x-1.5 sm:space-x-2 shrink-0">
        <!-- Quick Search Link -->
        <a
          href="/recipes"
          aria-label="Search recipes"
          class="p-2.5 text-stone-600 hover:text-amber-900 hover:bg-stone-100/80 rounded-full transition shrink-0"
          title="Browse Recipes"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </a>

        <!-- Social Icons: Instagram, X, Facebook -->
        <div class="hidden lg:flex items-center space-x-1 border-r border-stone-200/80 pr-2 mr-1 shrink-0">
          <a
            href="https://www.instagram.com/teaandtoastblog/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram @teaandtoastblog"
            class="p-2 text-stone-600 hover:text-amber-900 hover:bg-amber-50/80 rounded-full transition"
            title="Instagram @teaandtoastblog"
          >
            <svg class="w-4 h-4 text-amber-900" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
          <a
            href="https://x.com/teaandtoastblog"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="X @teaandtoastblog"
            class="p-2 text-stone-600 hover:text-amber-900 hover:bg-amber-50/80 rounded-full transition"
            title="X (Twitter) @teaandtoastblog"
          >
            <svg class="w-4 h-4 text-amber-900" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>
          <a
            href="https://www.facebook.com/profile.php?id=100063631472993"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook Page"
            class="p-2 text-stone-600 hover:text-amber-900 hover:bg-amber-50/80 rounded-full transition"
            title="Facebook Page"
          >
            <svg class="w-4 h-4 text-amber-900" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
        </div>

        <!-- Instagram Bio Hub Pill -->
        <a
          href="/links"
          class="inline-flex items-center gap-1.5 text-xs font-semibold px-3.5 py-2 bg-gradient-to-r from-amber-800 to-amber-900 hover:from-amber-900 hover:to-amber-950 text-white rounded-full shadow-sm hover:shadow transition whitespace-nowrap shrink-0"
        >
          <span>📱 Bio Hub</span>
        </a>

        <!-- Mobile Hamburger Toggle -->
        <button
          id="mobile-menu-toggle"
          type="button"
          class="md:hidden p-2.5 rounded-xl text-stone-700 hover:text-stone-900 hover:bg-stone-100 transition focus:outline-none shrink-0"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Open mobile menu"
        >
          <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Slide-Down Menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-b border-stone-200 bg-[#FAF8F5]/98 backdrop-blur-xl px-4 pt-3 pb-6 space-y-3 shadow-lg transition-all duration-200"
  >
    <div class="space-y-1">
      <a
        href="/"
        class={`flex items-center justify-between px-4 py-2.5 rounded-xl text-sm font-semibold transition ${
          isPathActive('/') ? 'bg-amber-900 text-white' : 'text-stone-800 hover:bg-stone-100'
        }`}
      >
        <span>Home</span>
      </a>

      <!-- Mobile Recipe Categories -->
      <div class="pt-1">
        <span class="block px-4 py-1 text-[11px] font-bold uppercase tracking-wider text-amber-900/70">
          Recipe Categories
        </span>
        <div class="grid grid-cols-2 gap-1.5 mt-1 px-2">
          {recipeCategories.map((cat) => (
            <a
              href={cat.href}
              class="flex items-center gap-2 px-3 py-2 rounded-xl text-xs font-semibold bg-white border border-stone-200/80 text-stone-700 hover:bg-amber-50 hover:text-amber-900 transition"
            >
              <span>{cat.icon}</span>
              <span class="truncate">{cat.name}</span>
            </a>
          ))}
        </div>
      </div>

      <a
        href="/#tea-toast-pairing"
        class="flex items-center justify-between px-4 py-2.5 rounded-xl text-sm font-semibold text-stone-800 hover:bg-stone-100 transition"
      >
        <span>Pairing Tool</span>
        <span class="text-xs">🫖</span>
      </a>

      <a
        href="/about"
        class={`flex items-center justify-between px-4 py-2.5 rounded-xl text-sm font-semibold transition ${
          isPathActive('/about') ? 'bg-amber-900 text-white' : 'text-stone-800 hover:bg-stone-100'
        }`}
      >
        <span>About</span>
      </a>
    </div>

    <!-- Mobile Bio Hub Card -->
    <div class="pt-2 border-t border-stone-200/80">
      <a
        href="/links"
        class="flex items-center justify-between p-3 bg-gradient-to-r from-amber-100/90 to-orange-100/70 border border-amber-200 rounded-2xl text-amber-950 font-semibold text-sm shadow-sm"
      >
        <span class="flex items-center gap-2">
          <span>📱</span>
          <span>Instagram Bio Hub & Links</span>
        </span>
        <span class="text-xs font-bold text-amber-800 bg-white/80 px-2 py-1 rounded-lg">Open →</span>
      </a>

      <div class="mt-3 flex items-center justify-center gap-4 text-xs text-stone-600">
        <a
          href="https://www.instagram.com/teaandtoastblog/"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-amber-900 font-semibold flex items-center gap-1"
        >
          <span>Instagram</span>
        </a>
        <span>•</span>
        <a
          href="https://x.com/teaandtoastblog"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-amber-900 font-semibold flex items-center gap-1"
        >
          <span>X / Twitter</span>
        </a>
        <span>•</span>
        <a
          href="https://www.facebook.com/profile.php?id=100063631472993"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-amber-900 font-semibold flex items-center gap-1"
        >
          <span>Facebook</span>
        </a>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  // Mobile Menu Toggle with Animated Icon
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  if (toggleBtn && mobileMenu) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', (!isExpanded).toString());
      mobileMenu.classList.toggle('hidden');
      if (hamburgerIcon && closeIcon) {
        hamburgerIcon.classList.toggle('hidden');
        closeIcon.classList.toggle('hidden');
      }
    });

    // Close menu when clicking outside
    document.addEventListener('click', (e) => {
      if (!toggleBtn.contains(e.target) && !mobileMenu.contains(e.target)) {
        mobileMenu.classList.add('hidden');
        toggleBtn.setAttribute('aria-expanded', 'false');
        if (hamburgerIcon && closeIcon) {
          hamburgerIcon.classList.remove('hidden');
          closeIcon.classList.add('hidden');
        }
      }
    });
  }

  // Dismiss Top Bar
  const dismissBtn = document.getElementById('dismiss-bar-btn');
  const topBar = document.getElementById('top-announcement-bar');
  if (dismissBtn && topBar) {
    dismissBtn.addEventListener('click', () => {
      topBar.style.display = 'none';
    });
  }
</script>
