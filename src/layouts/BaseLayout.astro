---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  pubDate?: Date;
  author?: string;
  adSenseClientId?: string; // Optional user's AdSense ID
}

const {
  title = 'Tea & Toast | Cozy Artisanal Toasts & Afternoon Tea Rituals',
  description = 'Elevating your morning routines and teatime pauses. Discover perfected sourdough toasts, whipped spreads, comforting bakes, and mindful loose-leaf tea pairings.',
  image = 'https://images.unsplash.com/photo-1525351484163-7529414344d8?q=80&w=1200&auto=format&fit=crop',
  article = false,
  pubDate,
  author = 'Tea & Toast Team',
  adSenseClientId,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://teaandtoastblog.pages.dev');
const formattedTitle = title.includes('Tea & Toast') ? title : `${title} | Tea & Toast`;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🍞</text></svg>" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary SEO -->
    <title>{formattedTitle}</title>
    <meta name="title" content={formattedTitle} />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={formattedTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="Tea & Toast" />
    {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={formattedTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Google Web Fonts (Playfair Display + Inter) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />

    <!-- Google AdSense Script (Activated automatically when adSenseClientId is provided) -->
    {adSenseClientId && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adSenseClientId}`}
        crossorigin="anonymous"
      ></script>
    )}

    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col bg-[#FAF8F5] text-stone-800">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
