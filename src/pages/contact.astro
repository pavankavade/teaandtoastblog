---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact Us | Tea & Toast"
  description="Have a question about a recipe, tea pairing suggestion, or collaboration? Reach out to the Tea & Toast editorial team."
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 space-y-8">
    <div class="text-center space-y-3">
      <span class="text-xs uppercase tracking-widest font-bold text-amber-800 bg-amber-100/80 px-3 py-1 rounded-full">
        Say Hello
      </span>
      <h1 class="text-3xl sm:text-5xl font-serif font-bold text-stone-900">
        Get in Touch
      </h1>
      <p class="text-stone-600 text-sm sm:text-base max-w-lg mx-auto">
        Have a question about a recipe, a suggestion for a tea pairing, or interested in brand partnerships? We’d love to hear from you.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 pt-4">
      <!-- Direct Info -->
      <div class="md:col-span-1 space-y-6">
        <div class="bg-white p-6 rounded-2xl border border-stone-200/80 shadow-sm space-y-4">
          <div>
            <h3 class="font-serif font-bold text-base text-stone-900">Editorial & Recipe Help</h3>
            <p class="text-xs text-stone-600 mt-1">hello@teaandtoastblog.com</p>
          </div>
          <div>
            <h3 class="font-serif font-bold text-base text-stone-900">Social Media</h3>
            <a
              href="https://www.instagram.com/teaandtoastblog/"
              target="_blank"
              class="text-xs text-amber-800 hover:underline font-semibold block mt-1"
            >
              @teaandtoastblog on Instagram
            </a>
          </div>
          <div>
            <h3 class="font-serif font-bold text-base text-stone-900">Response Time</h3>
            <p class="text-xs text-stone-500 mt-1">We usually respond within 24–48 hours.</p>
          </div>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="md:col-span-2">
        <form
          action="https://formspree.io/f/placeholder"
          method="POST"
          class="bg-white p-6 sm:p-8 rounded-2xl border border-stone-200/80 shadow-sm space-y-4"
        >
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="name" class="block text-xs font-bold uppercase tracking-wider text-stone-700 mb-1">
                Your Name
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full px-3.5 py-2.5 rounded-xl border border-stone-300 text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none"
                placeholder="Jane Doe"
              />
            </div>
            <div>
              <label for="email" class="block text-xs font-bold uppercase tracking-wider text-stone-700 mb-1">
                Email Address
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-3.5 py-2.5 rounded-xl border border-stone-300 text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none"
                placeholder="jane@example.com"
              />
            </div>
          </div>

          <div>
            <label for="subject" class="block text-xs font-bold uppercase tracking-wider text-stone-700 mb-1">
              Subject
            </label>
            <input
              type="text"
              id="subject"
              name="subject"
              required
              class="w-full px-3.5 py-2.5 rounded-xl border border-stone-300 text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none"
              placeholder="Recipe inquiry, pairing feedback..."
            />
          </div>

          <div>
            <label for="message" class="block text-xs font-bold uppercase tracking-wider text-stone-700 mb-1">
              Message
            </label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              class="w-full px-3.5 py-2.5 rounded-xl border border-stone-300 text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none"
              placeholder="Tell us what's on your mind..."
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full sm:w-auto px-6 py-3 bg-amber-800 hover:bg-amber-900 text-white rounded-xl text-sm font-semibold shadow transition duration-200"
          >
            Send Message
          </button>
        </form>
      </div>
    </div>
  </div>
</BaseLayout>
