---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import { getCollection } from 'astro:content';

const allRecipes = await getCollection('recipes');
const recentRecipes = allRecipes.slice(0, 4);

const quickLinks = [
  {
    title: '🍞 Explore All Recipes & Measurements',
    subtitle: 'Step-by-step guides, ingredient scaling & print cards',
    href: '/recipes',
    featured: true,
  },
  {
    title: '🫖 Interactive Tea & Toast Pairing Tool',
    subtitle: 'Find the sommelier-approved brew for your bread',
    href: '/#tea-toast-pairing',
    featured: false,
  },
  {
    title: '👩‍🍳 About Tea & Toast & Our Story',
    subtitle: 'The philosophy behind the crust & the leaf',
    href: '/about',
    featured: false,
  },
];
---

<BaseLayout
  title="Link in Bio | Tea & Toast"
  description="All the latest recipe links, tea pairing guides, and breakfast inspiration from @teaandtoastblog on Instagram."
>
  <div class="max-w-xl mx-auto px-4 py-10 sm:py-16 text-center space-y-6">
    <!-- Bio Header -->
    <div class="space-y-3">
      <div class="w-20 h-20 mx-auto rounded-full bg-amber-100 border-2 border-amber-300 flex items-center justify-center text-4xl shadow-inner">
        🍞
      </div>
      <h1 class="font-serif text-3xl font-bold text-stone-900">Tea & Toast</h1>
      <p class="text-xs font-semibold uppercase tracking-widest text-amber-800">
        @teaandtoastblog
      </p>
      <p class="text-sm text-stone-600 max-w-sm mx-auto leading-relaxed">
        Elevating your morning slice and teatime ritual. Tap below for full printable recipes, measurements, and pairings!
      </p>
    </div>

    <!-- Top Links -->
    <div class="space-y-3 text-left">
      {quickLinks.map((link) => (
        <a
          href={link.href}
          class={`block p-4 rounded-2xl border transition shadow-sm hover:shadow-md ${
            link.featured
              ? 'bg-amber-800 text-amber-50 border-amber-900 hover:bg-amber-900'
              : 'bg-white border-stone-200 text-stone-800 hover:border-amber-300'
          }`}
        >
          <div class="font-serif font-bold text-base">{link.title}</div>
          <div class={`text-xs mt-0.5 ${link.featured ? 'text-amber-200' : 'text-stone-500'}`}>
            {link.subtitle}
          </div>
        </a>
      ))}
    </div>

    <!-- Ad Unit -->
    <div class="my-6">
      <AdSlot slotType="in-article" />
    </div>

    <!-- Latest As Seen on Reels -->
    <div class="text-left space-y-3 pt-4 border-t border-stone-200">
      <h2 class="text-xs uppercase tracking-widest font-bold text-stone-500">
        Latest Recipes from Reels & Shorts
      </h2>
      <div class="space-y-2.5">
        {recentRecipes.map((recipe) => (
          <a
            href={`/recipes/${recipe.id}`}
            class="flex items-center gap-3 p-2.5 bg-white border border-stone-200 rounded-xl hover:border-amber-400 shadow-sm transition group"
          >
            <img
              src={recipe.data.heroImage}
              alt={recipe.data.title}
              class="w-14 h-14 rounded-lg object-cover flex-shrink-0"
            />
            <div class="flex-1 min-w-0">
              <h3 class="font-serif font-semibold text-sm text-stone-900 truncate group-hover:text-amber-800">
                {recipe.data.title}
              </h3>
              <p class="text-[11px] text-stone-500 flex items-center gap-2 mt-0.5">
                <span>⏱️ {recipe.data.totalTime}</span>
                <span>•</span>
                <span>{recipe.data.category}</span>
              </p>
            </div>
            <span class="text-stone-400 group-hover:text-amber-800 text-sm font-bold pr-1">→</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
